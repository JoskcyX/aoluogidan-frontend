# URL of the standalone backend API (server-side only, never exposed to the browser)
API_URL="https://aoluogidan-backend.onrender.com"

# Must exactly match the backend's JWT_SECRET — used here only to verify
# (not create) session tokens, in middleware and Server Components.
JWT_SECRET="replace-with-a-long-random-string"

# Used to build absolute URLs in sitemap.xml / robots.txt
SITE_URL="http://localhost:3000"

